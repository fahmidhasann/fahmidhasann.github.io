{
  "name": "fahmid-hasan-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Static portfolio site. The published site is plain HTML/CSS/JS with no build step; this manifest only exists for development tooling.",
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 4173 --bind 127.0.0.1",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:html": "html-validate index.html v2/index.html",
    "test": "playwright test",
    "test:install": "playwright install --with-deps chromium",
    "screenshots": "node tests/visual-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.57.0",
    "eslint": "^10.8.0",
    "globals": "^16.5.0",
    "html-validate": "^10.1.1",
    "stylelint": "^17.0.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
